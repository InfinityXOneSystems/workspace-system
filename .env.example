# Google Workspace System - Environment Variables

# Google Cloud
GOOGLE_CLOUD_PROJECT=infinity-x-one-systems
GOOGLE_APPLICATION_CREDENTIALS=/path/to/trinity-workspace-agent-key.json
GOOGLE_SERVICE_ACCOUNT_EMAIL=trinity-workspace-agent@infinity-x-one-systems.iam.gserviceaccount.com

# Domain-wide delegation user (for acting on behalf of users)
GOOGLE_DELEGATED_USER=info@infinityxonesystems.com

# Server configuration
PORT=8080
NODE_ENV=production

# Optional: Logging
LOG_LEVEL=info
